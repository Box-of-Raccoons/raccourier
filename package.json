{
  "name": "raccourier",
  "version": "1.4.0",
  "description": "Desktop notifier that Claude can push mail-triage summaries and alerts to.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Box-of-Raccoons/raccourier.git"
  },
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "mcp": "node mcp/server.js",
    "test": "vitest run",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.17",
    "marked": "^14.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fast-uri": "^3.1.4"
  },
  "build": {
    "appId": "com.raccourier.app",
    "productName": "Raccourier",
    "files": [
      "app/**/*",
      "mcp/**/*",
      "shared/**/*",
      "build/icon.png",
      "build/trayTemplate.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Box-of-Raccoons",
        "repo": "raccourier",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Raccourier"
    }
  }
}
